# ==============================================================================
# Template Konfigurasi AutoLogin Captive PENS
# ==============================================================================
# Salin file ini menjadi 'config.env' lalu sesuaikan isinya:
#   cp config.env.example config.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Daftar Akun Mahasiswa PENS
# ------------------------------------------------------------------------------
# Urutan USERS dan PASSWORDS harus sama/sejajar.
# Sistem akan otomatis menggilir akun setiap hari, atau beralih ke akun berikutnya
# jika akun sebelumnya sudah mencapai batas limit (misal: "logged in 3 times").
USERS=(
    "mahasiswa1@it.student.pens.ac.id"
    "mahasiswa2@te.student.pens.ac.id"
    "mahasiswa3@elka.student.pens.ac.id"
)

PASSWORDS=(
    "PasswordMhs1"
    "PasswordMhs2"
    "PasswordMhs3"
)

# ------------------------------------------------------------------------------
# 2. Konfigurasi Bot Telegram (Opsional / Notifikasi & Cek Akun)
# ------------------------------------------------------------------------------
# Dapatkan BOT_TOKEN dari @BotFather di Telegram
# Dapatkan CHAT_ID pengguna atau grup (misal: via @userinfobot atau ID grup)
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
CHAT_ID="-1001234567890"

# ------------------------------------------------------------------------------
# 3. Konfigurasi Jaringan & Interface
# ------------------------------------------------------------------------------
# Interface jaringan yang terhubung ke jaringan kampus PENS:
# - Jika menggunakan kabel LAN: biasanya 'eth0', 'enp3s0', atau 'eno1' (default: 'eth0')
# - Jika menggunakan Wi-Fi: sesuaikan dengan kartu wireless Anda, misal 'wlan0', 'wlan1', 'wlp2s0', dst.
# Cek dengan perintah: 'ip link' atau 'ip a' (cari nama interface yang statusnya UP)
IFACE="eth0"

# URL pengecekan koneksi internet (mengembalikan status 204 jika internet aktif)
CHECK_URL="http://www.gstatic.com/generate_204"

# ------------------------------------------------------------------------------
# 4. URL Captive Portal & Port (PENTING: BEDA LOKASI/LAB BISA BEDA URL)
# ------------------------------------------------------------------------------
# Di kampus PENS, host dan port captive portal bisa berbeda-beda tergantung gedung,
# lantai, access point, atau VLAN (misal: iac1, iac2, iac7, dst dengan port 8008, 8009, dll).
#
# CARA MENGETAHUI URL LOGIN DI LOKASI KAMU:
# 1. Konek ke jaringan kampus (kabel LAN atau WiFi PENS).
# 2. Buka browser, lalu coba buka sembarang situs HTTP (misal: http://neverssl.com atau http://google.com).
# 3. Browser akan otomatis mengarahkan (redirect) ke halaman login captive portal PENS.
# 4. Salin URL lengkap di address bar browser dan masukkan ke LOGIN_URL di bawah ini.
#
LOGIN_URL="https://iac7.pens.ac.id:8009/index.php?zone=misc"

# ORIGIN (opsional, jika dikosongkan akan otomatis diambil dari LOGIN_URL di atas)
ORIGIN="https://iac7.pens.ac.id:8009"

# ------------------------------------------------------------------------------
# 5. Lokasi File Status & Log
# ------------------------------------------------------------------------------
# Lokasi penyimpanan memori akun aktif dan riwayat login
STATE_FILE="/var/local/captive_state.txt"
LOG_FILE="/var/local/rekap_mingguan.txt"
NOTIF_STATE="/var/local/last_notified.txt"
SESSION_FILE="/var/local/captive_session.txt"
COOKIE_FILE="/var/local/captive_cookies.txt"

# Interval pengecekan internet (dalam detik)
CHECK_INTERVAL=30

# ------------------------------------------------------------------------------
# 6. Notifikasi & Monitoring Status VM
# ------------------------------------------------------------------------------
# Kirim notifikasi status VM (CPU, RAM, Disk, Uptime, IP) saat service bot menyala / VM boot
NOTIFY_VM_ON_START="true"

